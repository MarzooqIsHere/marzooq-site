---
layout: base.njk
ogImage: photography
description: "Photography by Marzooq Subhani: landscapes and travel across Wales and beyond, plus graduation, event and headshot commissions in Bristol."
title: Photography
permalink: /photography/
---
<section class="page-head">
  <h1>{% t "Photography", "Ffotograffiaeth" %}</h1>
  <p class="intro">{% t "Mostly Wales and wherever I'm travelling, usually as the light goes. I also shoot graduations, formals, society events and headshots in Bristol.", "Cymru gan amlaf, a lle bynnag dw i'n teithio, fel arfer wrth i'r golau fynd. Dw i hefyd yn tynnu lluniau graddio, digwyddiadau ffurfiol, digwyddiadau cymdeithasau a lluniau proffil ym Mryste." %}</p>
</section>

<div class="tabs" role="tablist" aria-label="Photography sections">
  <button type="button" role="tab" id="tab-personal" aria-controls="panel-personal" aria-selected="true">{% t "Personal work", "Gwaith personol" %}</button>
  <button type="button" role="tab" id="tab-commissions" aria-controls="panel-commissions" aria-selected="false" tabindex="-1">{% t "Commissions", "Comisiynau" %}</button>
  <button type="button" role="tab" id="tab-map" aria-controls="panel-map" aria-selected="false" tabindex="-1">{% t "Map", "Map" %}</button>
</div>

<div id="panel-personal" role="tabpanel" aria-labelledby="tab-personal">
  <div class="gallery">
    {%- for p in photos.personal %}
    <button type="button" class="shot" data-full="{{ p.image }}" data-caption="{{ p.caption }}" data-exif="{{ p.exif | exifLine }}"{% if p.location %} data-mappable="true"{% endif %} aria-label="Open photo{% if p.caption %}: {{ p.caption }}{% endif %}">
      <img class="dev" src="{{ p.image }}" alt="{{ p.alt or p.caption or 'Photograph by Marzooq Subhani' }}{% if p.alt and p.caption %}, {{ p.caption }}{% endif %}" {{ p.image | dims | safe }} {{ p.image | srcset("(min-width: 1000px) 30vw, (min-width: 640px) 45vw, 100vw") | safe }} loading="{{ "eager" if loop.first else "lazy" }}"{% if loop.first %} fetchpriority="high"{% endif %}>
    </button>
    {%- endfor %}
  </div>
</div>

<div id="panel-map" role="tabpanel" aria-labelledby="tab-map" hidden>
  <p class="map-note">{% t "Where the personal work was taken. Tap a pin to see the photos.", "Ble tynnwyd y gwaith personol. Tapiwch bin i weld y lluniau." %}</p>
  <div id="photo-map" aria-label="Map of photo locations"></div>
</div>
<script id="map-data" type="application/json">{{ photos.personal | mapPoints | json | safe }}</script>

<div id="panel-commissions" role="tabpanel" aria-labelledby="tab-commissions" hidden>
  <div class="book band">
    <p>{% t "Graduations, formals, society events and headshots in Bristol. Get in touch for a quote.", "Graddio, digwyddiadau ffurfiol, digwyddiadau cymdeithasau a lluniau proffil ym Mryste. Cysylltwch am bris." %}</p>
    <a class="amber-link" data-mail data-subject="Photography enquiry" href="/privacy/#contact">{% t "Email me to book →", "E-bostiwch fi i archebu →" %}</a>
  </div>
  <div class="gallery">
    {%- for p in photos.commissions %}
    <button type="button" class="shot" data-full="{{ p.image }}" data-caption="{{ p.caption }}" data-exif="{{ p.exif | exifLine }}" aria-label="Open photo{% if p.caption %}: {{ p.caption }}{% endif %}">
      <img class="dev" src="{{ p.image }}" alt="{{ p.alt or 'Commissioned photograph by Marzooq Subhani' }}" {{ p.image | dims | safe }} {{ p.image | srcset("(min-width: 1000px) 30vw, (min-width: 640px) 45vw, 100vw") | safe }} loading="lazy">
    </button>
    {%- endfor %}
  </div>
</div>

{% if kit.items.length %}
<section class="kit">
  <button type="button" class="cv-toggle kit-toggle" aria-expanded="false" aria-controls="kit-body">
    <span class="cv-title">{% t "Kit and process", "Offer a phroses" %}</span>
    <span class="sign" aria-hidden="true">+</span>
  </button>
  <dl class="kit-body" id="kit-body" hidden>
    {%- for k in kit.items %}
    <div><dt class="label amber">{{ k.label }}</dt><dd>{{ k.value }}</dd></div>
    {%- endfor %}
  </dl>
</section>
{% endif %}

<dialog id="lightbox" aria-label="Photo viewer">
  <button type="button" class="lb-close" aria-label="Close">×</button>
  <button type="button" class="lb-prev" aria-label="Previous photo">‹</button>
  <button type="button" class="lb-next" aria-label="Next photo">›</button>
  <img alt="">
  <div class="lb-meta">
    <span class="lb-count" aria-live="polite"></span>
    <p class="label"></p>
    <button type="button" class="lb-map" hidden>
      <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.1-7-11.5A7 7 0 0 1 19 9.5C19 14.9 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
      {% t "View on map", "Gweld ar y map" %}
    </button>
    <button type="button" class="lb-details" aria-expanded="false" aria-controls="lb-exif" hidden>{% t "Details", "Manylion" %} <span class="sign-mini" aria-hidden="true">+</span></button>
    <p class="lb-exif" id="lb-exif" hidden></p>
  </div>
</dialog>
