<!doctype html>
<html lang="en" data-theme="dark" data-lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} · {% endif %}Marzooq Subhani</title>
{%- set desc = description or "Marzooq Subhani: Mathematics and Philosophy student at the University of Bristol, writer of Grounded, and photographer from Cardiff." %}
<meta name="description" content="{{ desc }}">
<link rel="canonical" href="https://marzooq.co.uk{{ page.url }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Marzooq Subhani">
<meta property="og:title" content="{% if title %}{{ title }} · {% endif %}Marzooq Subhani">
<meta property="og:description" content="{{ desc }}">
<meta property="og:url" content="https://marzooq.co.uk{{ page.url }}">
<meta property="og:image" content="https://marzooq.co.uk/images/personal/personal-03.jpg">
<meta name="twitter:card" content="summary_large_image">
<link rel="sitemap" type="application/xml" href="/sitemap.xml">
{%- if page.url == "/" %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Marzooq Subhani",
  "url": "https://marzooq.co.uk/",
  "image": "https://marzooq.co.uk/images/portrait-brandon-hill.jpg",
  "description": "Mathematics and Philosophy student at the University of Bristol, writer and photographer from Cardiff.",
  "email": "mailto:me@marzooq.co.uk",
  "homeLocation": { "@type": "Place", "name": "Cardiff, Wales" },
  "alumniOf": { "@type": "CollegeOrUniversity", "name": "University of Bristol" },
  "knowsAbout": ["Philosophy", "Ethics", "Social and political philosophy", "Philosophy of religion", "Islamic philosophy", "Photography"],
  "sameAs": [
    "https://groundedbymarzooq.substack.com",
    "https://www.instagram.com/mrzq.jpg",
    "https://www.instagram.com/marzooqishere",
    "https://www.linkedin.com/in/marzooq/"
  ]
}
</script>
{%- endif %}
<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
<meta name="theme-color" content="#16110E">
<script>
  // Set theme and language before the page paints, so it doesn't flash.
  try {
    var t = localStorage.getItem("theme"); if (t) document.documentElement.dataset.theme = t;
    if (t === "light") document.querySelector('meta[name="theme-color"]').content = "#EEE5D8";
    var l = localStorage.getItem("lang"); if (l) { document.documentElement.dataset.lang = l; document.documentElement.lang = l; }
  } catch (e) {}
</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Inter:wght@400;500&display=swap">
<link rel="stylesheet" href="/assets/css/site.css?v={{ build }}">
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<div class="wrap">
  <header class="nav">
    <a class="brand" href="/">Marzooq Subhani</a>
    <nav aria-label="Main">
      <a href="/photography/"{% if page.url == "/photography/" %} aria-current="page"{% endif %}>{% t "Photography", "Ffotograffiaeth" %}</a>
      <a href="/#writing">{% t "Writing", "Ysgrifennu" %}</a>
      <a href="/shelf/"{% if page.url == "/shelf/" %} aria-current="page"{% endif %}>{% t "Shelf", "Silff" %}</a>
      <a href="/cv/"{% if page.url == "/cv/" %} aria-current="page"{% endif %}>CV</a>
      <a href="/#now">{% t "Now", "Nawr" %}</a>
      <a href="mailto:me@marzooq.co.uk">{% t "Contact", "Cysylltu" %}</a>
    </nav>
    <div class="toggles">
      <button type="button" class="icon-btn" id="theme-toggle" aria-label="Switch between light and dark mode">
        <svg class="moon" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
        <svg class="sun" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <button type="button" class="lang-btn" id="lang-toggle" aria-label="Newid iaith / Switch language">
        <span class="opt-en">EN</span> / <span class="opt-cy">CY</span>
      </button>
      <span class="learner">Dysgwr ydw i</span>
    </div>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="foot band">
    <span>© Marzooq Subhani</span>
    <nav class="foot-icons" aria-label="Elsewhere">
      <a class="icon-link" href="mailto:me@marzooq.co.uk" aria-label="Email" data-label="Email"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 6.5 8.5 6.5 8.5-6.5"/></svg></a>
      <a class="icon-link" href="https://www.instagram.com/marzooqishere" target="_blank" rel="noopener" aria-label="Instagram (personal)" data-label="Instagram (personal)"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.5"/><path d="M5 20a7 7 0 0 1 14 0"/></svg></a>
      <a class="icon-link" href="https://www.instagram.com/mrzq.jpg" target="_blank" rel="noopener" aria-label="Instagram (photography)" data-label="Instagram (photography)"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h3l1.5-2h7L17 8h3v11H4z"/><circle cx="12" cy="13" r="3.5"/></svg></a>
      <a class="icon-link" href="https://www.linkedin.com/in/marzooq/" target="_blank" rel="noopener" aria-label="LinkedIn" data-label="LinkedIn"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5h6v2M3 12h18"/></svg></a>
      <a class="icon-link" href="https://groundedbymarzooq.substack.com" target="_blank" rel="noopener" aria-label="Grounded (Substack)" data-label="Grounded (Substack)"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20l4-1 11-11-3-3L5 16z"/><path d="M14 7l3 3"/></svg></a>
      {% if cv.pdf %}<a class="icon-link" href="{{ cv.pdf }}" aria-label="CV (PDF)" data-label="CV (PDF)"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h8l4 4v14H6z"/><path d="M14 3v4h4M9 12h6M9 16h6"/></svg></a>{% endif %}
    </nav>
  </footer>
</div>
<script src="/assets/js/site.js?v={{ build }}"></script>
</body>
</html>
