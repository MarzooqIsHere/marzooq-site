<!doctype html>
<html lang="en" data-theme="dark" data-lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} · {% endif %}Marzooq Subhani</title>
{%- set desc = description or "Marzooq Subhani: Mathematics and Philosophy student at the University of Bristol, writer of Grounded, and photographer from Cardiff." %}
<meta name="description" content="{{ desc }}">
<link rel="canonical" href="https://marzooq.co.uk{{ page.url }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Marzooq Subhani">
<meta property="og:title" content="{% if title %}{{ title }} · {% endif %}Marzooq Subhani">
<meta property="og:description" content="{{ desc }}">
<meta property="og:url" content="https://marzooq.co.uk{{ page.url }}">
<meta property="og:image" content="https://marzooq.co.uk/images/personal/personal-03.jpg">
<meta name="twitter:card" content="summary_large_image">
<link rel="sitemap" type="application/xml" href="/sitemap.xml">
{%- if page.url == "/" %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Marzooq Subhani",
  "url": "https://marzooq.co.uk/",
  "image": "https://marzooq.co.uk/images/portrait-brandon-hill.jpg",
  "description": "Mathematics and Philosophy student at the University of Bristol, writer and photographer from Cardiff.",
  "email": "mailto:me@marzooq.co.uk",
  "homeLocation": { "@type": "Place", "name": "Cardiff, Wales" },
  "alumniOf": { "@type": "CollegeOrUniversity", "name": "University of Bristol" },
  "knowsAbout": ["Philosophy", "Ethics", "Social and political philosophy", "Philosophy of religion", "Islamic philosophy", "Photography"],
  "sameAs": [
    "https://groundedbymarzooq.substack.com",
    "https://www.instagram.com/mrzq.jpg",
    "https://www.linkedin.com/in/marzooq"
  ]
}
</script>
{%- endif %}
<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
<script>
  // Set theme and language before the page paints, so it doesn't flash.
  try {
    var t = localStorage.getItem("theme"); if (t) document.documentElement.dataset.theme = t;
    var l = localStorage.getItem("lang"); if (l) { document.documentElement.dataset.lang = l; document.documentElement.lang = l; }
  } catch (e) {}
</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Inter:wght@400;500&display=swap">
<link rel="stylesheet" href="/assets/css/site.css">
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<div class="wrap">
  <header class="nav">
    <a class="brand" href="/">Marzooq Subhani</a>
    <nav aria-label="Main">
      <a href="/photography/"{% if page.url == "/photography/" %} aria-current="page"{% endif %}>{% t "Photography", "Ffotograffiaeth" %}</a>
      <a href="/#writing">{% t "Writing", "Ysgrifennu" %}</a>
      <a href="/cv/"{% if page.url == "/cv/" %} aria-current="page"{% endif %}>CV</a>
      <a href="/#now">{% t "Now", "Nawr" %}</a>
      <a href="mailto:me@marzooq.co.uk">{% t "Contact", "Cysylltu" %}</a>
    </nav>
    <div class="toggles">
      <button type="button" class="icon-btn" id="theme-toggle" aria-label="Switch between light and dark mode">
        <svg class="moon" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
        <svg class="sun" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <button type="button" class="lang-btn" id="lang-toggle" aria-label="Newid iaith / Switch language">
        <span class="opt-en">EN</span> / <span class="opt-cy">CY</span>
      </button>
      <span class="learner">Dysgwr ydw i</span>
    </div>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="foot band">
    <a href="mailto:me@marzooq.co.uk">me@marzooq.co.uk</a>
    <span class="foot-links">
      <a href="https://www.instagram.com/mrzq.jpg">Instagram @mrzq.jpg</a>
      <a href="https://groundedbymarzooq.substack.com">Grounded</a>
      {% if cv.pdf %}<a href="{{ cv.pdf }}">CV (PDF)</a>{% endif %}
    </span>
  </footer>
</div>
<script src="/assets/js/site.js"></script>
</body>
</html>
